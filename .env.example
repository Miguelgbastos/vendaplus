# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://sfafavzfqxicmhustedu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Worker (header Authorization: Bearer <WORKER_SECRET>)
WORKER_SECRET=

# AES-256-GCM key for Kommo tokens e Secret Key por tenant (64 hex = 32 bytes)
# Gere com: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# OAuth state HMAC (string longa e aleatória)
# Gere com: openssl rand -base64 48
OAUTH_STATE_SECRET=

# Credenciais Kommo são por tenant (integração privada), configuradas na UI /kommo.
# Não use KOMMO_CLIENT_ID / KOMMO_CLIENT_SECRET globais.
