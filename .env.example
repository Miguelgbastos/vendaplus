# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Prefira a Publishable key (sb_publishable_...). A anon JWT legada segue compatível.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Prefira a Secret key (sb_secret_...). Nunca use NEXT_PUBLIC_ neste segredo.
SUPABASE_SECRET_KEY=
# Compatibilidade opcional com projetos legados:
# SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protege a primeira instalação. Mínimo de 32 caracteres; remova após concluir /setup.
SETUP_SECRET=

# Worker (header Authorization: Bearer <WORKER_SECRET>)
WORKER_SECRET=

# AES-256-GCM key for Kommo tokens e Secret Key por tenant (64 hex = 32 bytes)
# Gere com: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# OAuth state HMAC (string longa e aleatória)
# Gere com: openssl rand -base64 48
OAUTH_STATE_SECRET=

# Credenciais Kommo são por empresa (integração privada), configuradas na UI.
# Não use KOMMO_CLIENT_ID / KOMMO_CLIENT_SECRET globais.
